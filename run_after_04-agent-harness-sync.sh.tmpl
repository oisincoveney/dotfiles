#!/bin/bash
# Sync the Claude Code, Codex, and OMP harness on every chezmoi apply so deleted assets are restored even when the
# canonical source has not changed. agent-sync is the sole harness installer (ENG-25); mise installs the pinned
# GitHub release from the agent manifest before this after-script runs.
#
# Ordering: numbered after 03-mise-install so agent-sync is installed before this calls it. `mise exec` avoids stale
# absolute PATH entries inherited by a long-running terminal or desktop app.
#
# Caveat: agent-sync rewrites live harness files. On `cza` this runs against whatever agent session may be open; a
# live `claude`/`codex` picks up hook/settings changes on its next tool call, not mid-call.
set -euo pipefail

command -v mise >/dev/null 2>&1 || { echo "mise not installed; cannot sync agent harness." >&2; exit 1; }

export MISE_SYSTEM_CONFIG_FILE="$HOME/.config/mise/agent.toml"
mise which agent-sync >/dev/null 2>&1 || { echo "agent-sync not installed through mise; cannot sync agent harness." >&2; exit 1; }

echo "Syncing agent harness via agent-sync…"
mise exec -- agent-sync
echo "Agent harness sync complete."
