{%- if os() == "macos" %}
# OrbStack SSH host for Linux machines
Include ~/.orbstack/ssh/config

{% endif -%}
# Tool-managed host blocks live in their own files so they never rewrite this
# managed base. Point each generator at its own file, e.g.:
#   coder config-ssh --ssh-config-file ~/.ssh/config.d/coder.conf
# (glob matching nothing is not an error, so the dir may be empty.)
Include ~/.ssh/config.d/*.conf

# Herdr agent hosts. Each one reaches the other two over the tailnet.
# netcup and momokaya-2: OpenSSH accepts dev only on tailnet port 2222 (port 22
# is Tailscale SSH and denies dev); infra modules/agent-host.nix owns the keys.
# The Mac: macOS Remote Login; home/.ssh/authorized_keys.peers owns the keys.
Host netcup-dev
  HostName netcup
  Port 2222
  User dev

Host momokaya-2-dev
  HostName momokaya-2
  Port 2222
  User dev

Host oisin-mac
  HostName oisins-macbook-pro
  User oisin

Host *
  AddKeysToAgent yes
{%- if os() == "macos" %}
  UseKeychain yes
{%- endif %}
  IdentityFile ~/.ssh/id_ed25519
