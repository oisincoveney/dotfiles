#!/bin/bash
# Install Moka 3.24.3's Claude Code adapters after the shared Yeet-owned harness.
# Codex and retired OpenCode outputs are isolated and discarded.
set -euo pipefail

readonly MOKA_PACKAGE="@oisincoveney/pipeline@3.24.3"

command -v mise >/dev/null 2>&1 || { echo "mise not installed; cannot sync Moka adapters." >&2; exit 1; }

export MISE_SYSTEM_CONFIG_FILE="$HOME/.config/mise/agent.toml"
mise which nubx >/dev/null 2>&1 || { echo "nubx not installed through mise; cannot sync Moka adapters." >&2; exit 1; }

claude_config_dir="${CLAUDE_CONFIG_DIR:-$HOME/.claude}"

has_newer_moka_claude_adapter() {
  local adapter="$1"

  grep -Fxq '<!-- Generated by @oisin-ee/moka. -->' "$adapter" && \
    grep -Fxq '<!-- @oisin-ee/moka:host=claude-code -->' "$adapter"
}

newer_moka_claude_adapters_present() {
  local adapter

  shopt -s nullglob
  for adapter in \
    "$claude_config_dir/commands"/moka-*.md \
    "$claude_config_dir/agents"/moka-*.md; do
    if has_newer_moka_claude_adapter "$adapter"; then
      return 0
    fi
  done

  return 1
}

set --
if newer_moka_claude_adapters_present; then
  echo "Migrating Claude adapter ownership to ${MOKA_PACKAGE}…"
  set -- --force
fi

# Moka 3.24.3 has no host selector, but its adapters honor the native host
# config-root overrides. Keep Claude Code live while sending Codex and OpenCode
# writes to an isolated directory that is removed even if Moka fails.
moka_isolation_dir="$(mktemp -d "${TMPDIR:-/tmp}/moka-adapters.XXXXXX")"
cleanup_moka_isolation() {
  rm -rf -- "$moka_isolation_dir"
}
trap cleanup_moka_isolation EXIT
trap 'exit 1' HUP INT TERM

export CODEX_HOME="$moka_isolation_dir/codex"
export OPENCODE_CONFIG_DIR="$moka_isolation_dir/opencode"

# Moka adapters are global. Discard a caller-provided project target and run
# from HOME so cza never creates or updates repository-local files.
unset PIPELINE_TARGET_PATH

echo "Syncing Moka host adapters…"
mise exec -- nubx -y -p "$MOKA_PACKAGE" --cwd "$HOME" moka init "$@"
echo "Moka host adapter sync complete."
