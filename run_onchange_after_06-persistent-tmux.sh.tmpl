#!/usr/bin/env bash
# Enable the persistent tmux server on Linux boxes.
#
# Two things must hold for a tmux session to survive a closed laptop:
#   1. linger — the systemd user manager keeps running with no login present.
#   2. the tmux unit — the server runs under user@<uid>.service instead of the
#      SSH login's session scope, which systemd tears down on disconnect.
#
# unit hash: {{ include "dot_config/systemd/user/tmux.service" | sha256sum }}
set -euo pipefail

{{ if ne .chezmoi.os "linux" -}}
echo "Persistent tmux unit is Linux-only; skipping on {{ .chezmoi.os }}."
exit 0
{{ end -}}

if ! command -v systemctl >/dev/null 2>&1; then
	echo "systemd not available; skipping persistent tmux setup." >&2
	exit 0
fi

if ! systemctl --user show-environment >/dev/null 2>&1; then
	echo "No systemd user manager on this host; skipping persistent tmux setup." >&2
	exit 0
fi

# Linger keeps user@<uid>.service alive between logins. Without it the user
# manager stops at the last logout and takes the tmux server with it.
if [ "$(loginctl show-user "$(id -un)" -p Linger --value 2>/dev/null || echo no)" != "yes" ]; then
	echo "Enabling linger for $(id -un)…"
	loginctl enable-linger "$(id -un)"
fi

systemctl --user daemon-reload
systemctl --user enable --now tmux.service
echo "Persistent tmux server enabled. Attach with: t"
