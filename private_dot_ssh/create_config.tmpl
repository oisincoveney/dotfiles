{{ if eq .chezmoi.os "darwin" -}}
# OrbStack SSH host for Linux machines
Include ~/.orbstack/ssh/config

{{ end -}}
# Bootstrap only: tools such as Okteto write directly to ~/.ssh/config. Chezmoi
# creates this file when missing but never overwrites tool-generated host entries.
# Additional generators that support custom destinations should use config.d, e.g.:
#   coder config-ssh --ssh-config-file ~/.ssh/config.d/coder.conf
# (glob matching nothing is not an error, so the dir may be empty.)
Include ~/.ssh/config.d/*.conf

Host *
  AddKeysToAgent yes
{{- if eq .chezmoi.os "darwin" }}
  UseKeychain yes
{{- end }}
  IdentityFile ~/.ssh/id_ed25519
